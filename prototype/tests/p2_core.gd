extends SceneTree
func _initialize() -> void:
	var c = preload("res://battle/p2/ExternalController.gd").new()
	c.reset()
	assert(c.current.id == "A1")
	assert(c.session.queue.map(func(u): return u.id) == ["B1", "A2", "B2"])
	assert(c.begin_move([Vector2i(1,1), Vector2i(2,1)], func(_p): return true))
	assert(not c.wait_turn())
	assert(c.complete_move())
	assert(not c.complete_move())
	assert(c.current.move_points == 0)
	assert(c.defend())
	assert(c.current.id == "B1")
	assert(c.wait_turn() and c.wait_turn() and c.wait_turn())
	assert(c.session.round_number == 2)
	assert(c.session.units[0].battle_points == 2)
	assert(not c.session.units[0].defending)
	assert(c.session.units[1].battle_points == 6)
	assert(c.distance_increment(Vector2i.ZERO, Vector2i(2,1)) == 300)
	c.session.units[0].army.members[0].injury = 3
	c.reset()
	assert(c.session.units[0].army.members[0].injury == 0)
	print("P2 CORE PASS")
	quit()
